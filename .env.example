# Proxmox VE connection details
# For local QEMU VM with port forwarding:
PROXMOX_HOST=127.0.0.1
PROXMOX_PORT=8006

# Proxmox API Token authentication: PVEAPIToken=USER@REALM!TOKENID=SECRET
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=lxc-token
PROXMOX_TOKEN_VALUE=00000000-0000-0000-0000-000000000000

# Set to false for default Proxmox self-signed SSL certificates
PROXMOX_VERIFY_SSL=false

# Proxmox Host SSH settings for automation
PROXMOX_SSH_PORT=2222
PROXMOX_SSH_USER=root
PROXMOX_SSH_PASSWORD=12345678
PROXMOX_SSH_KEY=id_pve
